<dialog class="search-dialog" aria-label="Search the site">
  <input class="search-input" type="search" aria-label="Search query" placeholder="Search docs and reference…" autocomplete="off" spellcheck="false" role="combobox" aria-autocomplete="list" aria-controls="search-results" aria-expanded="false" />
  <div class="search-filters" role="group" aria-label="Search scope">
    <button type="button" data-scope="all" aria-pressed="true">All</button>
    <button type="button" data-scope="docs" aria-pressed="false">Docs</button>
    <button type="button" data-scope="reference" aria-pressed="false">Reference</button>
  </div>
  <p class="search-status" role="status">Type to search docs and reference.</p>
  <ul class="search-results" id="search-results" role="listbox" aria-label="Search results"></ul>
</dialog>

<script>
  import { excerpt } from '../search/excerpt.mjs';

  type Result = { id: string; url: string; type: string; title: string; namespace?: string; signature?: string; text: string };
  // An entry is either a result or a "show all" row that switches to that group's scope.
  type Entry = { result: Result } | { more: string };

  const TYPES = ['docs', 'reference'];
  const LABELS: Record<string, string> = { docs: 'Documentation', reference: 'Reference' };
  // How many of each group the "All" view shows before offering "Show all".
  const PREVIEW: Record<string, number> = { docs: 8, reference: 5 };
  const PAGE = 30;

  const dialog = document.querySelector<HTMLDialogElement>('.search-dialog')!;
  const input = dialog.querySelector<HTMLInputElement>('.search-input')!;
  const list = dialog.querySelector<HTMLUListElement>('.search-results')!;
  const status = dialog.querySelector<HTMLElement>('.search-status')!;
  const filters = [...dialog.querySelectorAll<HTMLButtonElement>('[data-scope]')];
  let search: ((query: string, scope: string) => Result[]) | undefined;
  let loading: Promise<void> | undefined;
  let scope = 'all';
  let hits: Result[] = [];
  let entries: Entry[] = [];
  let selected = 0;
  // In a single-scope view, the group results are appended to as the list scrolls.
  let section: HTMLElement | undefined;
  const sentinel = document.createElement('li');
  sentinel.setAttribute('role', 'presentation');
  sentinel.className = 'search-sentinel';
  const observer = new IntersectionObserver(seen => { if (seen.some(entry => entry.isIntersecting)) loadMore(); }, { root: list, rootMargin: '0px 0px 200px 0px' });
  observer.observe(sentinel);

  function select(index: number) {
    selected = index;
    list.querySelectorAll('[role="option"]').forEach((option, i) => option.setAttribute('aria-selected', String(i === selected)));
    const active = document.getElementById(`search-result-${selected}`);
    if (active) {
      input.setAttribute('aria-activedescendant', active.id);
      active.scrollIntoView({ block: 'nearest' });
    } else input.removeAttribute('aria-activedescendant');
  }

  function option(entry: Entry) {
    const option = document.createElement('div');
    option.id = `search-result-${entries.length}`;
    option.setAttribute('role', 'option');
    entries.push(entry);
    if ('more' in entry) {
      const button = document.createElement('button');
      button.type = 'button';
      button.tabIndex = -1;
      button.className = 'search-more';
      button.textContent = `Show all ${hits.filter(hit => hit.type === entry.more).length} ${LABELS[entry.more].toLowerCase()} results`;
      button.addEventListener('click', () => setScope(entry.more));
      option.append(button);
      return option;
    }
    const { result } = entry;
    const link = document.createElement('a');
    link.href = result.url;
    link.tabIndex = -1;
    const title = document.createElement(result.type === 'reference' ? 'code' : 'strong');
    title.textContent = result.signature || result.title;
    const detail = document.createElement('span');
    detail.textContent = `${result.namespace ? `${result.namespace} · ` : ''}${excerpt(result.text, input.value, 260)}`;
    link.append(title, detail);
    option.append(link);
    return option;
  }

  function group(type: string, count: number) {
    const group = document.createElement('li');
    group.setAttribute('role', 'group');
    group.setAttribute('aria-label', LABELS[type]);
    const label = document.createElement('div');
    label.className = 'search-group-label';
    label.textContent = `${LABELS[type]} (${count})`;
    label.setAttribute('role', 'presentation');
    group.append(label);
    return group;
  }

  function loadMore() {
    if (!section || entries.length >= hits.length) return false;
    for (const result of hits.slice(entries.length, entries.length + PAGE)) section.append(option({ result }));
    if (entries.length >= hits.length) sentinel.remove();
    return true;
  }

  function update() {
    if (!search) return;
    hits = search(input.value, scope);
    entries = [];
    section = undefined;
    list.replaceChildren();
    if (scope === 'all') {
      for (const type of TYPES) {
        const matching = hits.filter(hit => hit.type === type);
        if (!matching.length) continue;
        const block = group(type, matching.length);
        for (const result of matching.slice(0, PREVIEW[type])) block.append(option({ result }));
        if (matching.length > PREVIEW[type]) block.append(option({ more: type }));
        list.append(block);
      }
    } else if (hits.length) {
      section = group(scope, hits.length);
      list.append(section, sentinel);
      loadMore();
    }
    status.textContent = !input.value.trim() ? 'Type to search docs and reference.' : hits.length ? `${hits.length} result${hits.length === 1 ? '' : 's'}.` : 'No results. Try a different word or search scope.';
    list.scrollTop = 0;
    select(0);
  }

  function setScope(next: string) {
    scope = next;
    filters.forEach(filter => filter.setAttribute('aria-pressed', String(filter.dataset.scope === scope)));
    update();
    input.focus();
  }

  async function open() {
    if (!dialog.open) dialog.showModal();
    input.setAttribute('aria-expanded', 'true');
    input.focus();
    input.select();
    if (search) return;
    if (!loading) {
      status.textContent = 'Loading search…';
      loading = (async () => {
        try {
          const [response, { createSearch }] = await Promise.all([fetch('/search.json'), import('../search/engine.mjs')]);
          if (!response.ok) throw new Error(`Search: ${response.status}`);
          search = createSearch(await response.json());
          update();
        } catch {
          status.textContent = 'Search could not load. Close and reopen to retry.';
        } finally {
          loading = undefined;
        }
      })();
    }
    await loading;
  }

  input.addEventListener('input', update);
  filters.forEach(button => button.addEventListener('click', () => setScope(button.dataset.scope!)));
  input.addEventListener('keydown', event => {
    if (event.isComposing) return;
    if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
      event.preventDefault();
      if (event.key === 'ArrowDown' && selected === entries.length - 1) loadMore();
      select(Math.max(0, Math.min(entries.length - 1, selected + (event.key === 'ArrowDown' ? 1 : -1))));
    } else if (event.key === 'Enter' && entries[selected]) {
      event.preventDefault();
      const entry = entries[selected];
      if ('more' in entry) return setScope(entry.more);
      dialog.close();
      location.href = entry.result.url;
    }
  });
  list.addEventListener('click', event => {
    if ((event.target as HTMLElement).closest('a')) dialog.close();
  });
  dialog.addEventListener('close', () => input.setAttribute('aria-expanded', 'false'));
  dialog.addEventListener('click', event => { if (event.target === dialog) dialog.close(); });
  document.querySelectorAll('[data-search-open]').forEach(button => button.addEventListener('click', open));
  document.addEventListener('keydown', event => {
    const typing = event.target instanceof HTMLElement && event.target.closest('input, textarea, [contenteditable]');
    if ((event.key === '/' && !typing) || (event.key === 'k' && (event.metaKey || event.ctrlKey))) {
      event.preventDefault();
      open();
    }
  });
</script>
